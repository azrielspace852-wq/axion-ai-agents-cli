{
  "name": "axion-ai-agents-cli",
  "version": "1.2.0",
  "description": "AXION AI Agents CLI - terminal AI agent with workspace-aware tools, memory, and model management",
  "license": "GPL-3.0-or-later",
  "author": "AXION Neuralis",
  "bin": {
    "axion-cli": "dist/index.js",
    "axn-cli": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.copyFileSync('version.json','dist/version.json');fs.copyFileSync('update-info.json','dist/update-info.json');try{fs.chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "termux",
    "gemini",
    "gemma",
    "llm",
    "autonomous"
  ],
  "dependencies": {
    "axios": "1.7.2",
    "chalk": "4.1.2",
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "typescript": "5.4.5"
  }
}
